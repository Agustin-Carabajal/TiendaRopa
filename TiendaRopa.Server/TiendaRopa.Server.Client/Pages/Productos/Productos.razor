    // {
    //     var prod = productosActivos?.FirstOrDefault(p => p.Id == productoId);
    //     productoSeleccionadoNombre = prod?.Nombre ?? string.Empty;
    
    //     var respTodasLasVariantes = await http.Get<List<VarianteMostrarDTO>>("api/Variante/lista-variantes-activas");
    //     if (!respTodasLasVariantes.Error && respTodasLasVariantes.Respuesta != null)
    //     {
    //         var todasLasVariantes = respTodasLasVariantes.Respuesta;
    
           
    //         variantesProducto = todasLasVariantes
    //             .Where(v => v.ProductoId == productoId)
    //             .ToList();
    //     }
    //     else
    //     {
    //         variantesProducto = new List<VarianteMostrarDTO>();
    //     }
    
    //     mostrarModalDetalles = true;
    // }

    private async Task VerDetallesProducto(int productoId)
    {
        var prod = productosActivos?.FirstOrDefault(p => p.Id == productoId);
        productoSeleccionadoNombre = prod?.Nombre ?? string.Empty;
    
      
        var respTodasLasVariantes = await http.Get<List<VarianteMostrarDTO>>("api/Variante/lista-variantes-activas");
        if (!respTodasLasVariantes.Error && respTodasLasVariantes.Respuesta != null)
        {
            var todasLasVariantes = respTodasLasVariantes.Respuesta;
    
            variantesProducto = todasLasVariantes
                .Where(v => v.ProductoId == productoId)
                .ToList();
        }
        else
        {
            variantesProducto = new List<VarianteMostrarDTO>();
        }
    
        mostrarModalDetalles = true;
        StateHasChanged(); 
    }


    private async Task GuardarCambiosVarianteIndividual(VarianteMostrarDTO v)
    {
        var editarDto = new
        {
            Stock = v.Stock,
            PrecioVenta = v.PrecioVenta,
            CodVariante = v.CodVariante
        };

        var response = await http.Put($"api/Variante/editar/{v.Id}", editarDto);

        if (!response.Error)
        {
            Console.WriteLine($"Variante con ID {v.Id} modificada correctamente.");
        }
    }

    private void AbrirModalAgregar()
    {
        nuevoProductoDto = new RegistrarProductoCompletoDTO(); 
        if (proveedoresActivos.Any()) nuevoProductoDto.ProveedorId = proveedoresActivos.First().IdProveedor;
        mostrarModalAgregar = true;
    }

    private void CerrarModales()
    {
        mostrarModalDetalles = false;
        mostrarModalAgregar = false;
    }

    
    private void AlternarColor(int colorId, bool seleccionado)
    {
        if (seleccionado)
        {
            if (!nuevoProductoDto.Colores.Any(c => c.ColorId == colorId))
            {
                nuevoProductoDto.Colores.Add(new ColorSeleccionadoDTO { ColorId = colorId });
            }
        }
        else
        {
            var colorRemover = nuevoProductoDto.Colores.FirstOrDefault(c => c.ColorId == colorId);
            if (colorRemover != null) nuevoProductoDto.Colores.Remove(colorRemover);
        }
    }


    private void AlternarTalle(ColorSeleccionadoDTO colorDto, int talleId, bool seleccionado)
    {
        if (seleccionado)
        {
            if (!colorDto.Variantes.Any(v => v.TalleId == talleId))
            {
                colorDto.Variantes.Add(new VarianteTalleDTO { TalleId = talleId, Stock = 0, PrecioVenta = 0 });
            }
        }
        else
        {
            var varRemover = colorDto.Variantes.FirstOrDefault(v => v.TalleId == talleId);
            if (varRemover != null) colorDto.Variantes.Remove(varRemover);
        }
    }

    private VarianteTalleDTO ObtenerOInstanciarVariante(ColorSeleccionadoDTO colorDto, int talleId)
    {
        var variante = colorDto.Variantes.FirstOrDefault(v => v.TalleId == talleId);
        return variante ?? new VarianteTalleDTO();
    }


    private async Task GuardarProductoCompleto()
    {
        if (nuevoProductoDto.ProveedorId == 0) return;

        var response = await http.Post<RegistrarProductoCompletoDTO, object>("api/Producto/registrar-completo", nuevoProductoDto);

        if (!response.Error)
        {
            CerrarModales();
            await CargarGrillaPrincipal(); 
        }
        else
        {
   
            var codigoEstado = response.HttpResponseMessage?.StatusCode;
            Console.WriteLine($"Error al guardar. Código de estado: {codigoEstado}");
        }
    }


    private async Task EliminarProducto(int id)
    {
        var response = await http.Delete($"api/Producto/borrar/{id}");
        if (!response.Error)
        {
            await CargarGrillaPrincipal();
        }
    }

}
