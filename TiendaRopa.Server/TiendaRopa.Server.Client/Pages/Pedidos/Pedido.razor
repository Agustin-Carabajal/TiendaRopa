@page "/admin/pedidos/pedido"
@page "/admin/pedidos/pedido/{Id:int}"
@using TiendaRopa.Shared.DTO.Proveedor
@inject HttpClient Http
@inject NavigationManager Navigation

<h3>@(Id == null ? "Nuevo Pedido" : "Editar Pedido")</h3>

<EditForm Model="@modeloPedido" OnValidSubmit="Guardar">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="mb-3">
        <label class="form-label">Proveedor</label>
        <InputSelect @bind-Value="modeloPedido.IdProveedor" class="form-control">
            <option value="0">-- Seleccione un Proveedor --</option>
            @if (listaProveedores != null)
            {
                @foreach (var prov in listaProveedores)
                {
                    <option value="@prov.Id">@prov.RazonSocialProveedores</option>
                }
            }
        </InputSelect>
    </div>

    <div class="mb-3">
        <label class="form-label">Nro. Factura</label>
        <InputText @bind-Value="modeloPedido.FacturaPedido" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">Total Pedido</label>
        <InputNumber @bind-Value="modeloPedido.TotalPedido" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">Fecha de Pedido</label>
        <InputDate @bind-Value="modeloPedido.FechaDePedido" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">Fecha de Entrega (Opcional)</label>
        <InputDate @bind-Value="modeloPedido.FechaDeEntrega" class="form-control" />
    </div>

    <button type="submit" class="btn btn-primary" disabled="@(modeloPedido.IdProveedor == 0)">Guardar</button>
    <button type="button" class="btn btn-secondary" @onclick="Cancelar">Cancelar</button>
</EditForm>

@code {
    [Parameter] public int? Id { get; set; }

    public PedidoDTO modeloPedido { get; set; } = new PedidoDTO();
    private List<ProveedorDto>? listaProveedores;

    protected override async Task OnInitializedAsync()
    {
        
        listaProveedores = await Http.GetFromJsonAsync<List<ProveedorDto>>("api/proveedores");

        
        if (Id.HasValue)
        {
            var respuesta = await Http.GetFromJsonAsync<PedidoDTO>($"api/pedidos/{Id}");
            if (respuesta != null)
            {
                modeloPedido = respuesta;
            }
        }
    }

    private async Task Guardar()
    {
        if (modeloPedido.IdProveedor == 0) return; 

        if (Id == null)
        {
            await Http.PostAsJsonAsync("api/pedidos", modeloPedido);
        }
        else
        {
            await Http.PutAsJsonAsync($"api/pedidos/{Id}", modeloPedido);
        }

        Navigation.NavigateTo("/admin/pedidos");
    }

    private void Cancelar() => Navigation.NavigateTo("/admin/pedidos");
}
