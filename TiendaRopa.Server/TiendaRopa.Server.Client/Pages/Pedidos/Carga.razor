@page "/admin/detalles-pedido/detalle"
@page "/admin/detalles-pedido/detalle/{Id:int}"
@attribute [Authorize(Roles = "Admin")]
@using Microsoft.AspNetCore.Authorization
@using TiendaRopa.Shared.DTO.Producto_y_mas
@using TiendaRopa.Shared.DTO.Proveedor
@inject HttpClient Http
@inject NavigationManager Navigation

<h3>@(Id == null ? "Agregar Prenda a Pedido" : "Editar Detalle de Pedido")</h3>

<EditForm Model="@modeloDetalle" OnValidSubmit="Guardar">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="mb-3">
        <label class="form-label">Pedido (Nro. Factura)</label>
        <InputSelect @bind-Value="modeloDetalle.PedidoId" class="form-control">
            <option value="0">-- Seleccione el Pedido --</option>
            @if (listaPedidos != null)
            {
                @foreach (var ped in listaPedidos)
                {
                    <option value="@ped.Id">Factura: @ped.FacturaPedido</option>
                }
            }
        </InputSelect>
    </div>

    <div class="mb-3">
        <label class="form-label">Variante (producto, color y talle)</label>
        <InputSelect @bind-Value="modeloDetalle.VarianteId" class="form-control">
            <option value="0">-- Seleccione la Variante --</option>
            @if (listaVariantes != null)
            {
                @foreach (var variante in listaVariantes)
                {
                    <option value="@variante.Id">@variante.ProductoColor - Talle @variante.Talle - SKU @variante.CodVariante</option>
                }
            }
        </InputSelect>
    </div>

    <div class="mb-3">
        <label class="form-label">Cantidad Pedida</label>
        <InputNumber @bind-Value="modeloDetalle.Cant_prod_Pedido" class="form-control" />
    </div>

    <button type="submit" class="btn btn-primary"
            disabled="@(modeloDetalle.PedidoId == 0 || modeloDetalle.VarianteId == 0)">
        Guardar
    </button>
    <button type="button" class="btn btn-secondary" @onclick="Cancelar">Cancelar</button>
</EditForm>

@code {
    [Parameter] public int? Id { get; set; }

    public DetallePedidoDTO modeloDetalle { get; set; } = new DetallePedidoDTO();

   
    private List<PedidoDTO>? listaPedidos;
    private List<VarianteMostrarDTO>? listaVariantes;

    protected override async Task OnInitializedAsync()
    {
        
        listaPedidos = await Http.GetFromJsonAsync<List<PedidoDTO>>("api/pedidos");
        listaVariantes = await Http.GetFromJsonAsync<List<VarianteMostrarDTO>>("api/Variante/lista-variantes-activas");

        if (Id.HasValue)
        {
            var respuesta = await Http.GetFromJsonAsync<DetallePedidoDTO>($"api/detallespedido/{Id}");
            if (respuesta != null)
            {
                modeloDetalle = respuesta;
            }
        }
    }

    private async Task Guardar()
    {
        if (modeloDetalle.PedidoId == 0 || modeloDetalle.VarianteId == 0) return;

        if (Id == null)
        {
            await Http.PostAsJsonAsync("api/detallespedido", modeloDetalle);
        }
        else
        {
            await Http.PutAsJsonAsync($"api/detallespedido/{Id}", modeloDetalle);
        }

        Navigation.NavigateTo("/admin/detalles-pedido");
    }

    private void Cancelar() => Navigation.NavigateTo("/admin/detalles-pedido");
}
