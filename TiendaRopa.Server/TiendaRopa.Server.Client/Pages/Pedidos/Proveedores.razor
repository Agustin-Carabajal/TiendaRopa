<h3>Proveedores</h3>

@page "/admin/proveedores"
@using TiendaRopa.Shared.DTO.Proveedor
@inject HttpClient Http
@inject NavigationManager Navigation

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Listado de Proveedores</h2>
    <button class="btn btn-success" @onclick="IrAAñadir">
        <i class="oi oi-plus"></i> Añadir Proveedor
    </button>
</div>

@if (listaProveedores == null)
{
    <div class="d-flex justify-content-center">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Cargando...</span>
        </div>
    </div>
}
else if (!listaProveedores.Any())
{
    <div class="alert alert-info">No hay proveedores registrados en el sistema.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover vertical-align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Razón Social</th>
                    <th>CUIT</th>
                    <th>Contacto</th>
                    <th>Email</th>
                    <th class="text-center">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var prov in listaProveedores)
                {
                    <tr>
                        <td>@prov.RazonSocialProveedores</td>
                        <td>@prov.CuitProveedores</td>
                        <td>@prov.ContactoNombreProveedores</td>
                        <td>@prov.EmailProveedores</td>
                        <td class="text-center">
                            <button class="btn btn-warning btn-sm me-2" @onclick="() => IrAEditar(prov.Id)">
                                Editar
                            </button>
                            <button class="btn btn-danger btn-sm" @onclick="() => EliminarProveedor(prov.Id)">
                                Eliminar
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<ProveedorDto>? listaProveedores;

    protected override async Task OnInitializedAsync()
    {
        await CargarProveedores();
    }

    private async Task CargarProveedores()
    {
        try
        {
            listaProveedores = await Http.GetFromJsonAsync<List<ProveedorDto>>("api/proveedores");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar la lista: {ex.Message}");
        }
    }

    private void IrAAñadir()
    {
        Navigation.NavigateTo("/admin/proveedor");
    }

    private void IrAEditar(int id)
    {
        Navigation.NavigateTo($"/admin/proveedor/{id}");
    }

    private async Task EliminarProveedor(int id)
    {
        try
        {
            var respuesta = await Http.DeleteAsync($"api/proveedores/{id}");
            if (respuesta.IsSuccessStatusCode)
            {
                await CargarProveedores();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al eliminar: {ex.Message}");
        }
    }
}
