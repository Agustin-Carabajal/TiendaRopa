@page "/admin/proveedores"
@attribute [Authorize(Roles = "Admin")]
@using Microsoft.AspNetCore.Authorization
@using TiendaRopa.Shared.DTO.Proveedor
@inject HttpClient Http
@inject NavigationManager Navigation

<div class="d-flex justify-content-between align-items-center page-heading mb-4">
    <h2 class="page-title">Listado de Proveedores</h2>
    <button class="btn btn-success" @onclick="AbrirModalAgregar">
        <i class="oi oi-plus"></i> Añadir Proveedor
    </button>
</div>

@if (listaProveedores == null)
{
    <div class="d-flex justify-content-center">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Cargando...</span>
        </div>
    </div>
}
else if (!listaProveedores.Any())
{
    <div class="alert alert-info">No hay proveedores registrados en el sistema.</div>
}
else
{
    <div class="table-responsive tabla-fb">
        <table class="table table-striped table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Razón Social</th>
                    <th>CUIT</th>
                    <th>Contacto</th>
                    <th>Teléfono</th>
                    <th>Email</th>
                    <th class="text-center">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var proveedor in listaProveedores)
                {
                    <tr>
                        <td>@proveedor.RazonSocialProveedores</td>
                        <td>@proveedor.CuitProveedores</td>
                        <td>@proveedor.ContactoNombreProveedores</td>
                        <td>@proveedor.TelefonoContacto</td>
                        <td>@proveedor.EmailProveedores</td>
                        <td class="text-center">
                            <button class="btn btn-warning btn-sm me-2" @onclick="() => IrAEditar(proveedor.Id)">
                                Editar
                            </button>
                            <button class="btn btn-danger btn-sm" @onclick="() => EliminarProveedor(proveedor.Id)">
                                Eliminar
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (mostrarModalAgregar)
{
    <div class="modal fade show d-block modal-fb" tabindex="-1" role="dialog" aria-modal="true">
        <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header modal-header-agregar">
                    <h5 class="modal-title">Añadir proveedor</h5>
                    <button type="button" class="btn-close" aria-label="Cerrar" @onclick="CerrarModalAgregar"></button>
                </div>

                <EditForm Model="modeloProveedor" OnValidSubmit="GuardarProveedor">
                    <DataAnnotationsValidator />
                    <div class="modal-body">
                        @if (!string.IsNullOrWhiteSpace(mensajeError))
                        {
                            <div class="alert alert-danger" role="alert">@mensajeError</div>
                        }

                        <ValidationSummary class="alert alert-danger" />

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label">Razón Social *</label>
                                <InputText @bind-Value="modeloProveedor.RazonSocialProveedores" class="form-control" />
                                <ValidationMessage For="() => modeloProveedor.RazonSocialProveedores" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Número de Contacto *</label>
                                <InputText @bind-Value="modeloProveedor.TelefonoContacto" class="form-control" type="tel" />
                                <ValidationMessage For="() => modeloProveedor.TelefonoContacto" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">CUIT (opcional)</label>
                                <InputText @bind-Value="modeloProveedor.CuitProveedores" class="form-control" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Domicilio (opcional)</label>
                                <InputText @bind-Value="modeloProveedor.DomicilioProveedores" class="form-control" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Nombre de Contacto (opcional)</label>
                                <InputText @bind-Value="modeloProveedor.ContactoNombreProveedores" class="form-control" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Email (opcional)</label>
                                <InputText @bind-Value="modeloProveedor.EmailProveedores" class="form-control" type="email" />
                            </div>
                            <div class="col-12">
                                <label class="form-label">Observaciones (opcional)</label>
                                <InputTextArea @bind-Value="modeloProveedor.ObvsProveedores" class="form-control" rows="2" />
                            </div>
                        </div>
                    </div>

                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="CerrarModalAgregar">Cancelar</button>
                        <button type="submit" class="btn btn-primary">Guardar proveedor</button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@code {
    private List<ProveedorDto>? listaProveedores;
    private ProveedorDto modeloProveedor = new();
    private bool mostrarModalAgregar;
    private string? mensajeError;

    protected override async Task OnInitializedAsync()
    {
        await CargarProveedores();
    }

    private async Task CargarProveedores()
    {
        try
        {
            listaProveedores = await Http.GetFromJsonAsync<List<ProveedorDto>>("api/proveedores");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar la lista: {ex.Message}");
        }
    }

    private void AbrirModalAgregar()
    {
        modeloProveedor = new ProveedorDto();
        mensajeError = null;
        mostrarModalAgregar = true;
    }

    private void CerrarModalAgregar()
    {
        mostrarModalAgregar = false;
        mensajeError = null;
    }

    private async Task GuardarProveedor()
    {
        try
        {
            var respuesta = await Http.PostAsJsonAsync("api/proveedores", modeloProveedor);
            if (!respuesta.IsSuccessStatusCode)
            {
                mensajeError = await respuesta.Content.ReadAsStringAsync();
                return;
            }

            CerrarModalAgregar();
            await CargarProveedores();
        }
        catch (Exception ex)
        {
            mensajeError = $"No se pudo guardar el proveedor: {ex.Message}";
        }
    }

    private void IrAEditar(int id)
    {
        Navigation.NavigateTo($"/admin/proveedor/{id}");
    }

    private async Task EliminarProveedor(int id)
    {
        try
        {
            var respuesta = await Http.DeleteAsync($"api/proveedores/{id}");
            if (respuesta.IsSuccessStatusCode)
            {
                await CargarProveedores();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al eliminar: {ex.Message}");
        }
    }
}
