@page "/admin/proveedores"
@attribute [Authorize(Roles = "Admin")]
@using Microsoft.AspNetCore.Authorization
@using TiendaRopa.Shared.DTO.Proveedor
@inject HttpClient Http

<div class="d-flex justify-content-between align-items-center page-heading mb-4">
    <h2 class="page-title">Listado de Proveedores</h2>
    <button class="btn btn-success" @onclick="AbrirModalAgregar">
        <i class="oi oi-plus"></i> Añadir Proveedor
    </button>
</div>

@if (listaProveedores == null)
{
    <div class="d-flex justify-content-center">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Cargando...</span>
        </div>
    </div>
}
else if (!listaProveedores.Any())
{
    <div class="alert alert-info">No hay proveedores registrados en el sistema.</div>
}
else
{
    <div class="table-responsive tabla-fb">
        <table class="table table-striped table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Razón Social</th>
                    <th>CUIT</th>
                    <th>Contacto</th>
                    <th>Teléfono</th>
                    <th>Email</th>
                    <th class="text-center">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var proveedor in listaProveedores)
                {
                    <tr>
                        <td>@proveedor.RazonSocialProveedores</td>
                        <td>@proveedor.CuitProveedores</td>
                        <td>@proveedor.ContactoNombreProveedores</td>
                        <td>@proveedor.TelefonoContacto</td>
                        <td>@proveedor.EmailProveedores</td>
                        <td class="text-center">
                            <button class="btn btn-warning btn-sm me-2" @onclick="() => AbrirModalEditar(proveedor)">
                                Editar
                            </button>
                            <button class="btn btn-danger btn-sm" @onclick="() => EliminarProveedor(proveedor.Id)">
                                Eliminar
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<Proveedor Mostrar="mostrarModalProveedor"
           EsEdicion="esEdicion"
           Modelo="modeloProveedor"
           MensajeError="mensajeError"
           OnGuardar="GuardarProveedor"
           OnCancelar="CerrarModalProveedor" />

@code {
    private List<ProveedorDto>? listaProveedores;
    private ProveedorDto modeloProveedor = new();
    private bool mostrarModalProveedor;
    private bool esEdicion;
    private string? mensajeError;

    protected override async Task OnInitializedAsync()
    {
        await CargarProveedores();
    }

    private async Task CargarProveedores()
    {
        try
        {
            listaProveedores = await Http.GetFromJsonAsync<List<ProveedorDto>>("api/proveedores");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar la lista: {ex.Message}");
        }
    }

    private void AbrirModalAgregar()
    {
        modeloProveedor = new ProveedorDto();
        esEdicion = false;
        mensajeError = null;
        mostrarModalProveedor = true;
    }

    private void AbrirModalEditar(ProveedorDto proveedor)
    {
        modeloProveedor = new ProveedorDto
        {
            Id = proveedor.Id,
            RazonSocialProveedores = proveedor.RazonSocialProveedores,
            TelefonoContacto = proveedor.TelefonoContacto,
            CuitProveedores = proveedor.CuitProveedores,
            DomicilioProveedores = proveedor.DomicilioProveedores,
            ContactoNombreProveedores = proveedor.ContactoNombreProveedores,
            EmailProveedores = proveedor.EmailProveedores,
            ObvsProveedores = proveedor.ObvsProveedores
        };
        esEdicion = true;
        mensajeError = null;
        mostrarModalProveedor = true;
    }

    private void CerrarModalProveedor()
    {
        mostrarModalProveedor = false;
        mensajeError = null;
    }

    private async Task GuardarProveedor()
    {
        try
        {
            var respuesta = esEdicion
                ? await Http.PutAsJsonAsync($"api/proveedores/{modeloProveedor.Id}", modeloProveedor)
                : await Http.PostAsJsonAsync("api/proveedores", modeloProveedor);

            if (!respuesta.IsSuccessStatusCode)
            {
                mensajeError = await respuesta.Content.ReadAsStringAsync();
                return;
            }

            CerrarModalProveedor();
            await CargarProveedores();
        }
        catch (Exception ex)
        {
            mensajeError = $"No se pudo guardar el proveedor: {ex.Message}";
        }
    }

    private async Task EliminarProveedor(int id)
    {
        try
        {
            var respuesta = await Http.DeleteAsync($"api/proveedores/{id}");
            if (respuesta.IsSuccessStatusCode)
            {
                await CargarProveedores();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al eliminar: {ex.Message}");
        }
    }
}
