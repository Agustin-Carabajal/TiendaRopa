@page "/clientes"
@rendermode InteractiveAuto
@using TiendaRopa.Shared.DTO.Cliente;
@inject IHttpServicio http

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Gestión de Clientes</h2>
        <button class="btn btn-primary" @onclick="AbrirModalAgregar">
            <i class="bi bi-plus-circle"></i> Agregar Cliente
        </button>
    </div>

    @if (clientesActivos == null)
    {
        <div class="text-center my-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-2">Cargando clientes...</p>
        </div>
    }
    else if (!clientesActivos.Any())
    {
        <div class="alert alert-info text-center">No hay clientes registrados en el sistema.</div>
    }
    else
    {
        <table class="table table-striped table-hover align-middle shadow-sm">
            <thead class="table-dark">
                <tr>
                    <th>Nombre</th>
                    <th>Apellido</th>
                    <th>DNI</th>
                    <th>Cumpleaños</th>
                    <th>Domicilio</th>
                    <th>Teléfono</th>
                    <th>Saldo</th>
                    <th class="text-center">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var cliente in clientesActivos)
                {
                    <tr>
                        <td class="fw-bold">@cliente.Nombre</td>
                        <td>@cliente.Apellido</td>
                        <td>@cliente.Dni</td>
                        <td>@cliente.FechaNacimiento?.ToString("dd/MM/yyyy")</td>
                        <td>@cliente.Domicilio</td>
                        <td>@cliente.Telefono</td>
                        <td>$@cliente.Saldo.ToString("N2")</td>
                        <td class="text-center">
                            <button class="btn btn-info btn-sm me-2 text-white" @onclick="() => AbrirModalEditar(cliente)">
                                <i class="bi bi-pencil-square"></i> Ver Detalles y Editar
                            </button>
                            <button class="btn btn-danger btn-sm" @onclick="() => EliminarCliente(cliente.Id)">
                                <i class="bi bi-trash"></i> Eliminar
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@* Modal para Agregar / Editar Cliente *@
@if (mostrarModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content shadow">
                <div class="modal-header bg-dark text-white">
                    <h5 class="modal-title">
                        <i class="@(esEdicion ? "bi bi-pencil-square" : "bi bi-person-plus") me-2"></i>
                        @(esEdicion ? "Editar Cliente" : "Agregar Nuevo Cliente")
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CerrarModal"></button>
                </div>

                <EditForm Model="clienteForm" OnValidSubmit="GuardarCliente">
                    <DataAnnotationsValidator />

                    <div class="modal-body">
                        @if (!string.IsNullOrEmpty(mensajeErrorModal))
                        {
                            <div class="alert alert-danger py-2">@mensajeErrorModal</div>
                        }

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Nombre *</label>
                                <InputText class="form-control" @bind-Value="clienteForm.Nombre" placeholder="Ej: Juan" />
                                <ValidationMessage For="@(() => clienteForm.Nombre)" class="text-danger small" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-bold">Apellido</label>
                                <InputText class="form-control" @bind-Value="clienteForm.Apellido" placeholder="Ej: Pérez" />
                                <ValidationMessage For="@(() => clienteForm.Apellido)" class="text-danger small" />
                            </div>

                            <div class="col-md-4">
                                <label class="form-label fw-bold">DNI</label>
                                <InputText class="form-control" @bind-Value="clienteForm.Dni" placeholder="8 dígitos" />
                                <ValidationMessage For="@(() => clienteForm.Dni)" class="text-danger small" />
                            </div>

                            <div class="col-md-4">
                                <label class="form-label fw-bold">Fecha de Nacimiento</label>
                                <InputDate class="form-control" @bind-Value="clienteForm.FechaNacimiento" />
                                <ValidationMessage For="@(() => clienteForm.FechaNacimiento)" class="text-danger small" />
                            </div>

                            <div class="col-md-4">
                                <label class="form-label fw-bold">Teléfono</label>
                                <InputText class="form-control" @bind-Value="clienteForm.Telefono" placeholder="Ej: 3511234567" />
                                <ValidationMessage For="@(() => clienteForm.Telefono)" class="text-danger small" />
                            </div>

                            <div class="col-md-8">
                                <label class="form-label fw-bold">Domicilio</label>
                                <InputText class="form-control" @bind-Value="clienteForm.Domicilio" placeholder="Calle, Número, Barrio..." />
                                <ValidationMessage For="@(() => clienteForm.Domicilio)" class="text-danger small" />
                            </div>

                            <div class="col-md-4">
                                <label class="form-label fw-bold">Saldo inicial</label>
                                <InputNumber class="form-control" @bind-Value="clienteForm.Saldo" />
                                <ValidationMessage For="@(() => clienteForm.Saldo)" class="text-danger small" />
                            </div>

                            <div class="col-md-12">
                                <label class="form-label fw-bold">Rol</label>
                                <InputText class="form-control" @bind-Value="clienteForm.Rol" placeholder="Cliente / Mayorista / VIP" />
                                <ValidationMessage For="@(() => clienteForm.Rol)" class="text-danger small" />
                            </div>
                        </div>
                    </div>

                    <div class="modal-footer bg-light">
                        <button type="button" class="btn btn-secondary" @onclick="CerrarModal" disabled="@guardando">
                            Cancelar
                        </button>
                        <button type="submit" class="btn btn-primary" disabled="@guardando">
                            @if (guardando)
                            {
                                <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                                <span>Guardando...</span>
                            }
                            else
                            {
                                <span>Guardar</span>
                            }
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@code {
    private List<ClienteMostrarDTO>? clientesActivos;

    // Estado del modal y formulario
    private bool mostrarModal = false;
    private bool esEdicion = false;
    private bool guardando = false;
    private int clienteIdEditar = 0;
    private string? mensajeErrorModal;

    private ClienteCrearDTO clienteForm = new() { Nombre = string.Empty };

    protected override async Task OnInitializedAsync()
    {
        await CargarGrillaPrincipal();
    }

    private async Task CargarGrillaPrincipal()
    {
        var respProductos = await http.Get<List<ClienteMostrarDTO>>("api/Cliente/listarclientes");
        if (!respProductos.Error && respProductos.Respuesta != null)
        {
            clientesActivos = respProductos.Respuesta;
        }
        else
        {
            clientesActivos = new List<ClienteMostrarDTO>();
        }
    }

    private void AbrirModalAgregar()
    {
        esEdicion = false;
        clienteIdEditar = 0;
        mensajeErrorModal = null;
        clienteForm = new ClienteCrearDTO() { Nombre = string.Empty }; // Formulario limpio
        mostrarModal = true;
    }

    private void AbrirModalEditar(ClienteMostrarDTO cliente)
    {
        esEdicion = true;
        clienteIdEditar = cliente.Id;
        mensajeErrorModal = null;

        // Mapeamos los datos del cliente a editar hacia el DTO del formulario
        clienteForm = new ClienteCrearDTO
        {
            Nombre = cliente.Nombre,
            Apellido = cliente.Apellido,
            Dni = cliente.Dni,
            FechaNacimiento = cliente.FechaNacimiento,
            Domicilio = cliente.Domicilio,
            Telefono = cliente.Telefono,
            Saldo = cliente.Saldo,
            Rol = cliente.Rol
        };

        mostrarModal = true;
    }

    private void CerrarModal()
    {
        mostrarModal = false;
        mensajeErrorModal = null;
    }

    private async Task GuardarCliente()
    {
        guardando = true;
        mensajeErrorModal = null;

        if (esEdicion)
        {
            // El controller espera la entidad completa en PUT api/Cliente/editar/{id}
            var clienteUpdate = new
            {
                Id = clienteIdEditar,
                Nombre = clienteForm.Nombre,
                Apellido = clienteForm.Apellido,
                Dni = clienteForm.Dni,
                FechaNacimiento = clienteForm.FechaNacimiento,
                Domicilio = clienteForm.Domicilio,
                Telefono = clienteForm.Telefono,
                Saldo = clienteForm.Saldo,
                Rol = clienteForm.Rol
            };

            var response = await http.Put($"api/Cliente/editar/{clienteIdEditar}", clienteUpdate);
            if (!response.Error)
            {
                CerrarModal();
                await CargarGrillaPrincipal();
            }
            else
            {
                mensajeErrorModal = "No se pudo actualizar el cliente. Verifica los datos prestados.";
            }
        }
        else
        {
            // Petición POST para crear cliente (envía ClienteCrearDTO)
            var response = await http.Post<ClienteCrearDTO, int>("api/Cliente", clienteForm);
            if (!response.Error)
            {
                CerrarModal();
                await CargarGrillaPrincipal();
            }
            else
            {
                mensajeErrorModal = "Error al intentar registrar el cliente. Puede que ya se encuentre registrado.";
            }
        }

        guardando = false;
    }

    private async Task EliminarCliente(int id)
    {
        var response = await http.Delete($"api/Cliente/borrar/{id}");
        if (!response.Error)
        {
            await CargarGrillaPrincipal();
        }
    }
}
