@page "/admin/categorias"
@using TiendaRopa.Shared.DTO.Producto_y_mas
@rendermode InteractiveAuto
@inject IHttpServicio http

<div class="container-fluid mt-4">
    <h2 class="mb-4 text center">Gestión de Categorías de Ropa</h2>

    <div class="row">
        <!--Talles -->
        <div class="col-md-4 mb-4">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Talles</h5>
                    <button class="btn btn-light btn-sm" @onclick='() => Agregar("Talle")'>
                        <i class="oi oi-plus"></i> +
                    </button>
                </div>
                <div class="card-body p-0">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Descripción</th>
                                <th class="text-end px-3">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (listaTalles == null)
                            {
                                <tr><td colspan="2" class="text-center text-muted p-3">Cargando...</td></tr>
                            }
                            else if (!listaTalles.Any())
                            {
                                <tr><td colspan="2" class="text-center text-muted p-3">No hay registros</td></tr>
                            }
                            else
                            {
                                @foreach (var talle in listaTalles)
                                {
                                    <tr>
                                        <td class="align-middle">@talle.NombreTalle</td>
                                        <td class="text-end px-3">
                                            <button class="btn btn-outline-warning btn-sm me-1" @onclick='() => EditarTalle(talle.IdTalle, talle.NombreTalle)'>Editar</button>
                                            <button class="btn btn-outline-danger btn-sm" @onclick='() => Borrar(talle.IdTalle, "Talle")'>Borrar</button>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <!-- ================= TABLA DE COLORES ================= -->
        <div class="col-md-4 mb-4">
            <div class="card shadow-sm">
                <div class="card-header bg-success text-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Colores</h5>
                    <button class="btn btn-light btn-sm" @onclick='() => Agregar("Color")'>
                        <i class="oi oi-plus"></i> +
                    </button>
                </div>
                <div class="card-body p-0">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Descripción</th>
                                <th class="text-end px-3">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (listaColores == null)
                            {
                                <tr><td colspan="2" class="text-center text-muted p-3">Cargando...</td></tr>
                            }
                            else if (!listaColores.Any())
                            {
                                <tr><td colspan="2" class="text-center text-muted p-3">No hay registros</td></tr>
                            }
                            else
                            {
                                @foreach (var color in listaColores)
                                {
                                    <tr>
                                        <td class="align-middle">@color.NombreColor</td>
                                        <td class="text-end px-3">
                                            <button class="btn btn-outline-warning btn-sm me-1" @onclick='() => EditarColor(color.IdColor, color.NombreColor)'>Editar</button>
                                            <button class="btn btn-outline-danger btn-sm" @onclick='() => Borrar(color.IdColor, "Color")'>Borrar</button>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        
         
    </div>
</div>

@if (mostrarModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content shadow-lg">
                <div class="modal-header">
                    <h5 class="modal-title">@tituloModal @tipoAtributoSeleccionado</h5>
                    <button type="button" class="btn-close" @onclick="CerrarModal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Nueva Descripción:</label>

                        @if (tipoAtributoSeleccionado == "Talle")
                        {
                            <input type="text" class="form-control" @bind="textoTalle" placeholder="Ej: S, M, L, XL, 42..." />
                        }
                        else if (tipoAtributoSeleccionado == "Color")
                        {
                            <input type="text" class="form-control" @bind="textoColor" placeholder="Ej: Azul, Negro, Rojo..." />
                        }

                        @if (!string.IsNullOrEmpty(mensajeValidacion))
                        {
                            <div class="text-danger small mt-1">@mensajeValidacion</div>
                        }
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CerrarModal">Cancelar</button>
                    <button type="button" class="btn btn-primary" @onclick="ProcesarGuardado">Confirmar</button>
                </div>
            </div>
        </div>
    </div>
}
@code {
    private List<TalleMostrarDTO>? listaTalles;
    private List<ColorMostrarDTO>? listaColores;
  


    private string mensajeError = "";
    private string tipoAtributoSeleccionado = "";
    private int idRegistroSeleccionado = 0;
    private string textoTalle = "";
    private string textoColor = "";
    private string mensajeValidacion = "";
    private string tituloModal = "";
    private bool mostrarModal = false;

    protected override async Task OnInitializedAsync()
    {
        await CargarDatos();
    }

    private async Task CargarDatos()
    {
        mensajeError = "";
        var responseTalles = await http.Get<List<TalleMostrarDTO>>("api/Talle/listatalles");
        if (!responseTalles.Error && responseTalles.Respuesta != null)
        {
            listaTalles = responseTalles.Respuesta;
        }
        else
        {
            mensajeError = "Error al cargar los talles.";

        }
        var responseColores = await http.Get<List<ColorMostrarDTO>>("api/Color/listacolores");
        if (!responseColores.Error && responseColores.Respuesta != null)
        {
            listaColores = responseColores.Respuesta;
        }
        else
        {
            mensajeError = "Error al cargar los colores.";
        }

    }

    private async Task RecargarDatos()
    {
        mostrarModal = false;
        await CargarDatos();
    }

    private async Task ProcesarGuardado()
    {
        if (tipoAtributoSeleccionado == "Talle")
        {
            if (tituloModal == "Agregar") await CrearTalle();
            else if (tituloModal == "Editar") await ActualizarTalle();
        }
        else if (tipoAtributoSeleccionado == "Color")
        {
            if (tituloModal == "Agregar") await CrearColor();
            else if (tituloModal == "Editar") await ActualizarColor();
        }
    }

    private void Agregar(string tipo)
    {
        idRegistroSeleccionado = 0;
        tipoAtributoSeleccionado = tipo;
        mensajeValidacion = "";
        tituloModal = "Agregar";
        
        if (tipo == "Talle")
        {
            textoTalle = "";
        }
        else if (tipo == "Color")
        {
            textoColor = "";
        }
        mostrarModal = true;

    }



    private void EditarTalle(int id, string descripcionActual)
    {
        idRegistroSeleccionado = id;
        textoTalle = descripcionActual; // Cargamos el valor actual en la caja de texto de Talles
        mensajeValidacion = string.Empty;
        tipoAtributoSeleccionado = "Talle";
        tituloModal = "Editar";

        mostrarModal = true; // Abrimos el modal
    }

  

    private void EditarColor(int id, string descripcionActual)
    {
        idRegistroSeleccionado = id;
        textoColor = descripcionActual; // Cargamos el valor actual en la caja de texto de Colores
        mensajeValidacion = string.Empty;
        tipoAtributoSeleccionado = "Color";
        tituloModal = "Editar";

        mostrarModal = true; // Abrimos el modal
    }
    private void CerrarModal()
    {
        mostrarModal = false;
    }

    private async Task CrearTalle()
    {
        if (string.IsNullOrWhiteSpace(textoTalle)) return;

        string urlBase = $"api/Talle";


        // Consumimos tu POST que devuelve un ActionResult<int> (leemos el int de respuesta)
        var resultado = await http.Post<TalleCrearDTO, int>(urlBase, new TalleCrearDTO { NombreTalle = textoTalle });

        if (!resultado.Error)
        {
            await RecargarDatos();
        }
        else
        {
            mensajeValidacion = "El registro ya existe o los datos son inválidos.";
        } 

    }

    private async Task ActualizarTalle()
    {
        if (string.IsNullOrWhiteSpace(textoTalle)) return;

        var editarTalle = new {
            Id = idRegistroSeleccionado,
            NombreTalle = textoTalle
        };
        var resultado = await http.Put($"api/Talle/editar/{idRegistroSeleccionado}", editarTalle);

        if (!resultado.Error)
        {
            await RecargarDatos();
        }
        else
        {
            mensajeValidacion = "No se pudo actualizar el registro.";
        }
    }

    private async Task ActualizarColor()
    {
        if (string.IsNullOrWhiteSpace(textoColor)) return;

        var editarColor = new
        {
            Id = idRegistroSeleccionado,
            NombreColor = textoColor
        };
        var resultado = await http.Put($"api/Color/editar/{idRegistroSeleccionado}", editarColor);

        if (!resultado.Error)
        {
            await RecargarDatos();
        }
        else
        {
            mensajeValidacion = "No se pudo actualizar el registro.";
        }
    }

    private async Task CrearColor()
    {
        if (string.IsNullOrWhiteSpace(textoColor)) return;
        string urlBase = $"api/Color";

        var resultado = await http.Post<ColorCrearDTO, int>(urlBase, new ColorCrearDTO { NombreColor = textoColor });
        if (!resultado.Error)
        {
            await RecargarDatos();
        }
        else
        {
            mensajeValidacion = "El registro ya existe o los datos son inválidos.";
        }
    }

    private async Task Borrar(int id, string tipo)
    {
        // Ajustamos la URL a tu formato de controlador: api/Marcas/Borrar/5
        string url = $"api/{tipo}/borrar/{id}";

        // Asumo que tu método Delete sigue una estructura similar a tu Get
        // devolviendo un HttpRespuesta o un booleano de error
        var resultado = await http.Delete(url);

        if (!resultado.Error)
        {
            await CargarDatos(); // Recargamos la pantalla si la baja lógica fue exitosa
        }
    }
}