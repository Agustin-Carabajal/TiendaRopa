<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["lib/bootstrap/dist/css/bootstrap.min.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["TiendaRopa.Server.styles.css"]" />
    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet @rendermode="PageRenderMode" />
</head>

<body>
    <div id="initial-loading-screen" role="status" aria-live="polite" aria-label="Cargando Frida Boutique">
        <div class="loading-screen-content">
            <img src="@Assets["images/logo-frida-boutique.png"]" alt="Frida Boutique" />
            <div class="loading-indicator" aria-hidden="true"></div>
            <p>Preparando tu tienda...</p>
        </div>
    </div>

    <Routes @rendermode="PageRenderMode" />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]" autostart="false"></script>
    <script>
        Blazor.start()
            .then(() => document.documentElement.classList.add("app-ready"))
            .catch(error => {
                console.error("No se pudo iniciar la aplicación.", error);
                document.documentElement.classList.add("app-ready");
            });
    </script>
    <script src="@Assets["Components/Account/Shared/PasskeySubmit.razor.js"]" type="module"></script>
</body>

</html>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    private IComponentRenderMode? PageRenderMode =>
        HttpContext.AcceptsInteractiveRouting() ? InteractiveAuto : null;
}
